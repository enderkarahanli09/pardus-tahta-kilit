#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent group tahta-kilit >/dev/null; then
        addgroup --system tahta-kilit
    fi
    install -d -o root -g tahta-kilit -m 0750 /etc/tahta-kilit
    systemctl daemon-reload
    systemctl enable --now tahta-kilit-master-sync.timer
    # Otomatik tanı: kilit ekranındaki "Hata ayrıntısı" raporunu üretir, düşen doğrulama servisini kaldırır.
    systemctl enable --now tahta-kilit-tani.timer || true
    systemctl start --no-block tahta-kilit-tani.service || true
    # Otomatik kapanma: saat yönetim panelinden gelir; ayarlanmamışsa hiçbir şey yapmaz.
    systemctl enable --now tahta-kilit-kapanis.timer || true
    if [ -f /etc/tahta-kilit/config.json ] && [ -f /etc/tahta-kilit/board.key ]; then
        # Güncellemede mevcut anahtarları koru, yalnız çalışan doğrulayıcıyı yenile.
        systemctl try-restart tahta-kilit-verifier.service
    fi
fi

# İlk kurulumda servis, anahtar/config provision aracıyla oluşturulunca açılır.
exit 0
