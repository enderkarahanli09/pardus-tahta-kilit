#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent group tahta-kilit >/dev/null; then
        addgroup --system tahta-kilit
    fi
    install -d -o root -g tahta-kilit -m 0750 /etc/tahta-kilit
    systemctl daemon-reload
    if [ -f /etc/tahta-kilit/config.json ] && [ -f /etc/tahta-kilit/board.key ]; then
        # Güncellemede mevcut anahtarları koru, yalnız çalışan doğrulayıcıyı yenile.
        systemctl try-restart tahta-kilit-verifier.service
    fi
fi

# İlk kurulumda servis, anahtar/config provision aracıyla oluşturulunca açılır.
exit 0
