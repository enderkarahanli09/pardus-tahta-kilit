[Unit]
Description=BB Kilit QR ve altı haneli kod giriş penceresi
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m tahta_kilit.lock_screen
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
UnsetEnvironment=TAHTA_KILIT_TEST_MODE
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
