[Unit]
Description=Pardus ETAP dokunmatik tahta kilit ekranı
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m tahta_kilit.lock_screen
Restart=always
RestartSec=2
NoNewPrivileges=true
UnsetEnvironment=TAHTA_KILIT_TEST_MODE
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
